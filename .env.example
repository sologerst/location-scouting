# ---- Contact enrichment (skip trace) ----
# Provider for the contact-lookup half. Owner lookup works WITHOUT any of these.
#   apify | mock | (unset → "not configured" state in the UI)
SKIPTRACE_PROVIDER=mock
# Required when SKIPTRACE_PROVIDER=apify
APIFY_TOKEN=
# Optional override of the Apify actor id
APIFY_SKIPTRACE_ACTOR=one-api~skip-trace

# ---- Supabase (optional: lookup cache + search history) ----
# The app runs fine without these; they enable caching & history.
NEXT_PUBLIC_SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
